# ===== 数据库 =====
# 应用连接串。Docker Compose 自托管时 host 用服务名 db，例如：
#   postgresql://polymind:CHANGE_ME@db:5432/polymind
DATABASE_URL=postgresql://user:pass@localhost:5432/aichat
REDIS_URL=redis://redis:6379

# Postgres 容器初始化用（docker-compose 的 db 服务读取，需与 DATABASE_URL 一致）
POSTGRES_USER=polymind
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=polymind

# Upstash Redis（用于限流，REST API）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Better Auth =====
# 随机 32 字节：openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===== 微信开放平台（网站应用）=====
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=

# ===== GitHub OAuth =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== 模型 API =====
DEEPSEEK_API_KEY=sk-xxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxx
ANTHROPIC_PROXY_URL=
GOOGLE_API_KEY=AIzaxxxxxx
GOOGLE_PROXY_URL=
DASHSCOPE_API_KEY=sk-xxxxxx

# ===== 监控 =====
SENTRY_DSN=
